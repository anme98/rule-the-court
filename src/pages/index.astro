---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 4);
const categories = ['Alle', ...new Set(posts.map((post) => post.data.category))];
---

<MainLayout title="Volleyball. Mit Plan." description="Inspiration, Coaching und Trainingspläne für Volleyballerinnen und Volleyballer, die ihr Spiel bewusst weiterentwickeln wollen.">
  <section class="hero-home">
    <span class="eyebrow">Dein Spiel. Dein nächstes Level.</span>
    <h1><em>Rule The Court.</em></h1>
    <p>Gutes Volleyball beginnt mit guten Entscheidungen. Entdecke Ideen, Wissen und Training, die dich auf dem Feld wirklich weiterbringen.</p>
  </section>

  <section class="home-featured" aria-label="Ausgewählte Beiträge">
    <div class="featured-carousel">
      <div class="featured-track" id="featured-track" tabindex="0" aria-label="Ausgewählte Beiträge">
        {featuredPosts.map((post) => (
          <a class="featured-card" href={`/blog/${post.id}`}>
            <div class="featured-copy">
              <span class="tag">{post.data.category}</span>
              <h2>{post.data.title}</h2>
            </div>
            {post.data.image && <img src={post.data.image} alt="" loading="lazy" />}
          </a>
        ))}
      </div>
      <button class="carousel-button carousel-prev" type="button" data-carousel-direction="-1" aria-label="Vorherige Beiträge" hidden>←</button>
      <button class="carousel-button carousel-next" type="button" data-carousel-direction="1" aria-label="Nächste Beiträge" hidden>→</button>
    </div>
  </section>

  <section class="journal" aria-labelledby="journal-title">
    <div class="journal-top">
      <div>
        <span class="eyebrow">Das Journal</span>
        <h2 id="journal-title">Wissen für dein nächstes Level.</h2>
      </div>
      <span class="blog-meta">{posts.length} Beiträge zum Entdecken</span>
    </div>
    <div class="category-filters" aria-label="Beiträge nach Kategorie filtern">
      {categories.map((category, index) => (
        <button class="filter-button" type="button" data-filter={index === 0 ? 'all' : category} aria-pressed={index === 0 ? 'true' : 'false'}>
          {category}
        </button>
      ))}
    </div>
    <div class="blog-grid" id="blog-grid">
      {posts.map((post) => (
        <article class={post.data.isTextOnly ? 'blog-card text-only-card' : 'blog-card'} data-category={post.data.category}>
          {post.data.isTextOnly ? (
            <div class="text-card">
              <span class="tag">{post.data.category}</span>
              <div class="blog-card-copy">
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              </div>
              <time class="blog-meta" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('de-DE')}</time>
            </div>
          ) : (
            <>
              <a class="blog-image" href={`/blog/${post.id}`} aria-label={`Beitrag lesen: ${post.data.title}`}>
                <img src={post.data.image} alt="" loading="lazy" />
              </a>
              <div class="blog-card-copy">
                <span class="tag">{post.data.category}</span>
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <time class="blog-meta" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('de-DE')}</time>
              </div>
            </>
          )}
        </article>
      ))}
    </div>
  </section>

  <script>
    // ── Transform-based carousel ──────────────────────────────────────────────
    const track = document.querySelector<HTMLElement>('#featured-track');
    if (track) {
      const cards = Array.from(track.children) as HTMLElement[];
      const total = cards.length;
      let current = 0;
      let animating = false;

      // Returns the layout position of a card relative to the track start.
      // We use offsetLeft (unaffected by CSS transforms) rather than computing
      // i * step, which accumulates sub-pixel rounding errors across cards.
      // Note: cards' offsetParent is .featured-carousel (position:relative),
      // and track.offsetLeft is 0, so card.offsetLeft == card's position in track.
      function cardLayoutLeft(index: number): number {
        return (cards[index] as HTMLElement).offsetLeft - track.offsetLeft;
      }

      function isMobileView(): boolean {
        return window.matchMedia('(max-width: 768px)').matches;
      }

      function getOffset(index: number): number {
        const trackW = track.offsetWidth;
        const cardW  = (cards[index] as HTMLElement).offsetWidth;
        const left   = cardLayoutLeft(index);

        if (isMobileView()) {
          // Auf Mobile: genau ein Slide im View, kein Peek
          return -left;
        }

        if (index === 0) {
          // Flush left – first card at 0
          return 0;
        } else if (index === total - 1) {
          // Flush right – last card's right edge == track right edge
          return -(left - (trackW - cardW));
        } else {
          // Middle – show 40% of the previous card as a peek on the left
          const peek = (cards[index - 1] as HTMLElement).offsetWidth * 0.40;
          return -(left - peek);
        }
      }

      function goTo(index: number, smooth = true): void {
        if (animating && smooth) return;
        if (index < 0) index = total - 1;
        if (index >= total) index = 0;
        current = index;

        track.style.transition = smooth
          ? 'transform .45s cubic-bezier(.4,0,.2,1)'
          : 'none';
        track.style.transform = `translateX(${getOffset(current)}px)`;
        if (smooth) animating = true;
      }

      track.addEventListener('transitionend', () => { animating = false; });

      // Double rAF ensures layout is complete before we read dimensions
      requestAnimationFrame(() => { requestAnimationFrame(() => goTo(0, false)); });

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => goTo(current, false), 50);
      });

      // Touch swipe support on mobile
      let touchStartX = 0;
      let touchStartY = 0;
      track.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
          if (deltaX < 0) {
            goTo(current + 1);
          } else {
            goTo(current - 1);
          }
        }
      }, { passive: true });

      document.querySelectorAll('[data-carousel-direction]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = Number((btn as HTMLElement).dataset.carouselDirection);
          goTo(current + dir);
        });
      });

      // Always show both buttons (infinite loop)
      document.querySelectorAll<HTMLButtonElement>('[data-carousel-direction]').forEach((b) => {
        b.hidden = false;
      });
    }

    // ── Blog filter ──────────────────────────────────────────────────────────
    const filterButtons = document.querySelectorAll('[data-filter]');
    const blogCards = document.querySelectorAll('.blog-card[data-category]');
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = (button as HTMLElement).dataset.filter;
        filterButtons.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
        blogCards.forEach((card) => {
          (card as HTMLElement).hidden = category !== 'all' && (card as HTMLElement).dataset.category !== category;
        });
      });
    });
  </script>
</MainLayout>
