---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const categories = ['Alle', ...new Set(posts.map((post) => post.data.category))];
---

<MainLayout title="Volleyball. Mit Plan." description="Inspiration, Coaching und Trainingspläne für Volleyballerinnen und Volleyballer, die ihr Spiel bewusst weiterentwickeln wollen.">
  <section class="hero-home">
    <span class="eyebrow">Dein Spiel. Dein nächstes Level.</span>
    <h1>Spiel nicht nur mit.<br /><em>Run The Court.</em></h1>
    <p>Gutes Volleyball beginnt mit guten Entscheidungen. Entdecke Ideen, Wissen und Training, die dich auf dem Feld wirklich weiterbringen.</p>
  </section>

  <section class="home-featured" aria-label="Ausgewählte Beiträge">
    <div class="featured-carousel">
      <div class="featured-track" id="featured-track" tabindex="0" aria-label="Ausgewählte Beiträge">
        {featuredPosts.map((post) => (
          <a class="featured-card" href={`/blog/${post.id}`}>
            <div class="featured-copy">
              <span class="tag">{post.data.category}</span>
              <h2>{post.data.title}</h2>
              <span class="featured-link">Beitrag entdecken <span aria-hidden="true">↗</span></span>
            </div>
            {post.data.image && <img src={post.data.image} alt="" loading="lazy" />}
          </a>
        ))}
      </div>
      <button class="carousel-button carousel-prev" type="button" data-carousel-direction="-1" aria-label="Vorherige Beiträge" hidden>←</button>
      <button class="carousel-button carousel-next" type="button" data-carousel-direction="1" aria-label="Nächste Beiträge" hidden>→</button>
    </div>
  </section>

  <section class="journal" aria-labelledby="journal-title">
    <div class="journal-top">
      <div>
        <span class="eyebrow">Das Journal</span>
        <h2 id="journal-title">Wissen für dein nächstes Level.</h2>
      </div>
      <span class="blog-meta">{posts.length} Beiträge zum Entdecken</span>
    </div>
    <div class="category-filters" aria-label="Beiträge nach Kategorie filtern">
      {categories.map((category, index) => (
        <button class="filter-button" type="button" data-filter={index === 0 ? 'all' : category} aria-pressed={index === 0 ? 'true' : 'false'}>
          {category}
        </button>
      ))}
    </div>
    <div class="blog-grid" id="blog-grid">
      {posts.map((post) => (
        <article class={post.data.isTextOnly ? 'blog-card text-only-card' : 'blog-card'} data-category={post.data.category}>
          {post.data.isTextOnly ? (
            <div class="text-card">
              <span class="tag">{post.data.category}</span>
              <div class="blog-card-copy">
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </div>
              <time class="blog-meta" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('de-DE')}</time>
            </div>
          ) : (
            <>
              <a class="blog-image" href={`/blog/${post.id}`} aria-label={`Beitrag lesen: ${post.data.title}`}>
                <img src={post.data.image} alt="" loading="lazy" />
              </a>
              <div class="blog-card-copy">
                <span class="tag">{post.data.category}</span>
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <time class="blog-meta" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('de-DE')}</time>
              </div>
            </>
          )}
        </article>
      ))}
    </div>
  </section>

  <script>
    const carousel = document.querySelector('#featured-track');
    const carouselWrapper = carousel?.parentElement;
    const carouselButtons = document.querySelectorAll<HTMLButtonElement>('[data-carousel-direction]');
    const updateCarouselControls = () => {
      if (!carousel) return;
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      carouselButtons.forEach((button) => {
        const direction = Number(button.dataset.carouselDirection);
        button.hidden = direction < 0 ? carousel.scrollLeft <= 1 : carousel.scrollLeft >= maxScroll - 1;
      });
      carouselWrapper?.classList.toggle('is-scrollable', maxScroll > 1);
    };

    document.querySelectorAll('[data-carousel-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        const direction = Number(button.dataset.carouselDirection);
        carousel?.scrollBy({ left: direction * (carousel.clientWidth * 0.8), behavior: 'smooth' });
      });
    });
    carousel?.addEventListener('scroll', updateCarouselControls, { passive: true });
    window.addEventListener('resize', updateCarouselControls);
    updateCarouselControls();

    const filterButtons = document.querySelectorAll('[data-filter]');
    const blogCards = document.querySelectorAll('.blog-card[data-category]');
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.filter;
        filterButtons.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
        blogCards.forEach((card) => {
          card.hidden = category !== 'all' && card.dataset.category !== category;
        });
      });
    });
  </script>
</MainLayout>
