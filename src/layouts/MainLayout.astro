---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Volleyball besser verstehen. Smarter trainieren. Mit Rule The Court.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f6" />
    <title>{title} | Rule The Court</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <a class="brand" href="/" aria-label="Rule The Court – Startseite">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none">
            <circle cx="20" cy="20" r="18.5" stroke="currentColor" />
            <path d="M7.5 12.5c8 2 15 8.5 19.5 19M13 4.5c2.5 8 9 14.5 21.5 18M3 22c8-1 18 2 27.5 10M24 2.5c-1 8-5.5 17-17 25" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
        <span class="brand-name">Rule The Court</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
        <span></span><span></span>
        <span class="sr-only">Menü öffnen</span>
      </button>

      <nav class="primary-navigation" id="primary-navigation" aria-label="Hauptnavigation">
        <a class={`nav-link ${path === '/' ? 'active' : ''}`} href="/">Startseite</a>
        <div class={`nav-group ${path === '/coaching' ? 'active' : ''}`}>
          <button class="nav-link nav-trigger" type="button" aria-expanded="false" aria-haspopup="true">
            Coaching <span class="chevron" aria-hidden="true"></span>
          </button>
          <div class="nav-dropdown">
            <a href="/coaching">Unser Ansatz <span>Training mit Plan und Persönlichkeit.</span></a>
            <a href="/coaching#formate">Coaching-Formate <span>Finde den Rahmen, der zu dir passt.</span></a>
          </div>
        </div>
        <div class={`nav-group ${path === '/entwicklung' ? 'active' : ''}`}>
          <button class="nav-link nav-trigger" type="button" aria-expanded="false" aria-haspopup="true">
            Entwicklung <span class="chevron" aria-hidden="true"></span>
          </button>
          <div class="nav-dropdown">
            <a href="/entwicklung">Spielerentwicklung <span>Die Grundlagen für dein nächstes Level.</span></a>
            <a href="/entwicklung#bereiche">Unsere Schwerpunkte <span>Technik, Athletik und Spielintelligenz.</span></a>
          </div>
        </div>
        <a class={`nav-link nav-mobile-plans ${path === '/trainingsplaene' ? 'active' : ''}`} href="/trainingsplaene">Trainingspläne</a>
      </nav>

      <a class="button button-blue header-cta" href="/trainingsplaene">Trainingspläne <span aria-hidden="true">↗</span></a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <a class="brand footer-brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none">
            <circle cx="20" cy="20" r="18.5" stroke="currentColor" />
            <path d="M7.5 12.5c8 2 15 8.5 19.5 19M13 4.5c2.5 8 9 14.5 21.5 18M3 22c8-1 18 2 27.5 10M24 2.5c-1 8-5.5 17-17 25" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
        <span class="brand-name">Rule The Court</span>
      </a>
      <p>Weniger Zufall. Mehr Spielverständnis.</p>
      <span class="footer-copy">© {new Date().getFullYear()} Rule The Court</span>
    </footer>

    <script>
      const header = document.querySelector('#site-header');
      const menuToggle = document.querySelector('.menu-toggle');
      const navTriggers = [...document.querySelectorAll('.nav-trigger')];
      const closeMenus = () => {
        navTriggers.forEach((trigger) => {
          trigger.setAttribute('aria-expanded', 'false');
          trigger.closest('.nav-group')?.classList.remove('open');
        });
      };

      navTriggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          closeMenus();
          trigger.setAttribute('aria-expanded', 'true');
          trigger.closest('.nav-group')?.classList.add('open');
        });
        trigger.closest('.nav-group')?.addEventListener('mouseenter', () => {
          closeMenus();
          trigger.setAttribute('aria-expanded', 'true');
          trigger.closest('.nav-group')?.classList.add('open');
        });
      });

      header?.addEventListener('mouseleave', closeMenus);
      document.querySelectorAll('.nav-link:not(.nav-trigger)').forEach((link) => {
        link.addEventListener('mouseenter', closeMenus);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenus();
      });

      menuToggle?.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!isOpen));
        header?.classList.toggle('mobile-open', !isOpen);
      });
    </script>
  </body>
</html>
